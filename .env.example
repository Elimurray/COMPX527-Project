# Copy to .env and fill in. NEVER commit a real .env — it is gitignored for a reason.

# ---- AWS (used by the CDK app and the AWS CLI) ----
# Region the whole project deploys to. Mandated us-east-1, carried over from the
# individual assignment. cdk bootstrap has only been run for this account/region pair.
AWS_REGION=us-east-1
# Your AWS CLI named profile (each team member has their own IAM user).
AWS_PROFILE=derf-dev
# Target account for `cdk deploy`. Pinned in infra/lib/config.ts — a mismatch fails at synth.
CDK_DEFAULT_ACCOUNT=339254022271
CDK_DEFAULT_REGION=us-east-1

# ---- Deployment target ----
# One of: dev | prod. Prefixes stack and resource names so nobody clobbers anyone.
DERF_STAGE=dev

# ---- Frontend (Vite only exposes vars prefixed with VITE_) ----
# Filled in from CDK stack outputs after M2/M3 deploy.
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=us-east-1
