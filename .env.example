# Copy to .env and fill in. NEVER commit a real .env — it is gitignored for a reason.

# ---- AWS (used by the CDK app and the AWS CLI) ----
# Region the whole project deploys to. Agreed default: Sydney, lowest latency from NZ.
AWS_REGION=ap-southeast-2
# Your AWS CLI named profile (each team member has their own IAM user).
AWS_PROFILE=derf-dev
# Target account for `cdk deploy`. Fill in once M1 confirms which account the team uses.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=ap-southeast-2

# ---- Deployment target ----
# One of: dev | prod. Prefixes stack and resource names so nobody clobbers anyone.
DERF_STAGE=dev

# ---- Frontend (Vite only exposes vars prefixed with VITE_) ----
# Filled in from CDK stack outputs after M2/M3 deploy.
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_AWS_REGION=ap-southeast-2
