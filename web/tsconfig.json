{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    // Mirrors the Vite alias, so the type-checker and the bundler resolve the
    // shared package the same way.
    "paths": {
      "@derf/shared": ["../shared/src/index.ts"]
    }
  },
  "include": ["src/**/*", "vite.config.ts"]
}
